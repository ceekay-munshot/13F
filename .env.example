# Copy to .env for local runs:  node --env-file=.env scripts/13f-daily-index.mjs
# (Node 20.6+ reads --env-file natively; no dotenv dependency.)
#
# The SAME names are used as GitHub Actions repository secrets and as
# Cloudflare Pages environment variables. Every workflow has a "Validate
# secrets are present" step that fails fast before doing any work.

# ---------------------------------------------------------------------------
# SEC identity. REQUIRED — requests without a declared User-Agent get an
# "Undeclared Automated Tool" error page.
#
# Format is a plain space-separated "<App or Company Name> <contact email>",
# quoted verbatim from the SEC Webmaster FAQ. It is NOT a browser UA string and
# NOT an RFC-7231 product token.
# ---------------------------------------------------------------------------
SEC_USER_AGENT="Munshot 13F Pipeline ceekay@muns.io"

# Requests per second against sec.gov. The stated ceiling is 10 across ALL SEC
# hosts from one IP; we run at 5 with jitter to leave headroom for the SEC's
# own counting. Do not raise this.
SEC_RATE_LIMIT_RPS=5

# ---------------------------------------------------------------------------
# Ingest auth. Shared between GitHub Actions and Cloudflare Pages env.
# Capture endpoints FAIL CLOSED: on a non-localhost host with no secret
# configured they return 500 capture_misconfigured rather than accepting writes.
# ---------------------------------------------------------------------------
F13F_CAPTURE_SECRET="change-me-generate-with-openssl-rand-hex-32"

# Deploy targets the ingest scripts POST into.
F13F_URL_PROD="https://muns-13f.pages.dev"
F13F_URL_PREVIEW="https://preview.muns-13f.pages.dev"

# ---------------------------------------------------------------------------
# Optional. OpenFIGI is the FALLBACK for CUSIP -> ticker; the primary source is
# the SEC's own fails-to-deliver files (free, official, no rate limit worth
# worrying about). A free key raises OpenFIGI from 25 req/min x 10 jobs to
# 25 req/6s x 100 jobs — a 2-hour backfill becomes 2 minutes.
# ---------------------------------------------------------------------------
OPENFIGI_API_KEY=""
