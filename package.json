{
  "name": "muns-13f",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "13F Fund Tracker — SEC Form 13F holdings, consensus, and quarter-on-quarter changes across all US institutional filers. Embedded in the Munshot host via the Munshot Dashboard SDK.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/ci-guards.mjs",
    "check": "npm run guard && npm run typecheck && npm run test",
    "db:migrate:local": "wrangler d1 migrations apply muns-13f --local",
    "db:migrate:remote": "wrangler d1 migrations apply muns-13f --remote"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.14.0",
    "fast-xml-parser": "^4.5.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  }
}
